{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/node_modules",
      "!**/coverage",
      "!**/tests/fixtures/generated",
      "!**/tests/output",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
