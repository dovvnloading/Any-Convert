# Local: http://localhost:8080. Never expose the native port directly.
SITE_ADDRESS=:8080
PUBLIC_ORIGIN=http://localhost:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
CONTAINER_HTTP_PORT=8080
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
# For a domain with automatic HTTPS:
# SITE_ADDRESS=convert.example.com
# PUBLIC_ORIGIN=https://convert.example.com
# HTTP_BIND=0.0.0.0
# HTTP_PORT=80
# CONTAINER_HTTP_PORT=80
# HTTPS_BIND=0.0.0.0
# HTTPS_PORT=443
MAX_UPLOAD_MB=512
MAX_OUTPUT_MB=1024
MAX_DURATION_SECONDS=600
MAX_ACTIVE_JOBS=1
ENCODE_TIMEOUT_MS=900000
JOB_TTL_MS=3600000
