FROM node:22-bookworm-slim
# FFmpeg may include GPL-enabled codec libraries; see docs/SELF_HOST.md.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --chown=node:node apps/native-service ./apps/native-service
USER node
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4300 MEDIA_DIR=/data
EXPOSE 4300
CMD ["node", "apps/native-service/src/server.mjs"]
